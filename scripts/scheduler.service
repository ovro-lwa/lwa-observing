[Unit]
Description=OVRO-LWA Scheduler
After=network-online.target
Wants=network-online.target

[Service]
# Run as the specified user
Type=simple

# Setup the environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
WorkingDirectory=/home/pipeline/proj/lwa-shell/lwa-observing
ExecStart=/opt/devel/pipeline/envs/deployment/bin/python -s scripts/executor.py

# The scheduler is expected to run continuously.  Recover from unexpected
# interpreter, dependency, or service failures without restarting after an
# intentional systemctl stop.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
